{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild init-es.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/init-es.cjs",
    "start": "node dist/server.cjs",
    "init-es": "tsx init-es.ts",
    "test:ldap": "tsx scripts/ldap-test.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@google/genai": "^2.4.0",
    "@smithy/node-http-handler": "^4.7.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/js-yaml": "^4.0.9",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "ldapts": "^4.2.6",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "undici": "^6.26.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
